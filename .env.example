# ==========================================================
# DeshiMart Environment Configuration for Local & Render
# ==========================================================

# Port (Render sets this automatically to 10000, for local dev use 5005)
PORT=5005
NODE_ENV=production

# MongoDB Atlas Database Connection URI (Required for Render)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/deshimart?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/deshimart?retryWrites=true&w=majority

# Secret key for JWT Token Authentication (Render can auto-generate or use any 32+ char string)
JWT_SECRET=deshimart-super-secret-key-98765

# Google Gemini API Key for AI Farming Assistant (Optional, falls back to offline expert agronomist)
GEMINI_API_KEY=

# Active Payment Gateway Provider: 'razorpay' | 'cashfree' | 'upi_direct'
PAYMENT_GATEWAY_PROVIDER=razorpay

# Razorpay Test / Live API Credentials (Optional, test keys provided in repo)
RAZORPAY_KEY_ID=rzp_test_TW0IYLn9akaqhz
RAZORPAY_KEY_SECRET=12DmPyNEQzVI4DzwW7zW6wht

# Merchant UPI Information
MERCHANT_UPI_VPA=subarno.mallick.1@oksbi
MERCHANT_UPI_NAME=SUBARNO MALLICK
