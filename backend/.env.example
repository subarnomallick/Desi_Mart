# Port to run the backend server
PORT=5005

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/deshimart

# Secret key for JWT token hashing
JWT_SECRET=deshimart-super-secret-key-98765

# Optional: Google Gemini API Key for AI Farming Assistant
GEMINI_API_KEY=

# Active Payment Gateway Provider: 'cashfree' | 'razorpay' | 'upi_direct'
PAYMENT_GATEWAY_PROVIDER=upi_direct

# Cashfree Payment Gateway Credentials
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=SANDBOX

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Merchant UPI Details
MERCHANT_UPI_VPA=subarno.mallick.1@oksbi
